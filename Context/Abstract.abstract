NOT :: (A : bit) -> (Y : bit) {

}

OR  :: (A : bit, B : bit) -> (Y : bit) {

}

AND :: (A : bit, B : bit) -> (Y : bit) {

}

XOR :: (A : bit, B : bit) -> (Y : bit) {

}


FullAdder :: (A : bit, B : bit, Cin : bit) -> (Sum : bit, Cout : bit) {
	W1 :: XOR(A, B);
	W2 :: AND(A, B);
	W3 :: AND(W1, Cin);

	return XOR(W1, Cin), OR(W1, W3);
}












