else statement;




// if case statements
// -----------------------------------------------------------------
//	Matches the value of the variable with the case.
//	a smart switch-case and match like statement but more linguistically sound
SchematicInstances :: enum union {
	symbol 		: types.Symbol;
	wire		: types.Wire;
	joint 		: types.SolderJoint;
	spiceCommand	: types.SpiceCommand;
	lable		: types.Lable;
	comment		: types.Comment;
	hint		: types.Hint;
	option		: types.Option;
	link		: tyhpe.Link;
}


schInst : SchematicInstances;
ignoredInstancesCount : sszie;


if schInst {
	// unnamed type case
	// 	using the tagged union tag/enum name.
	case .wire {
		reduce(wire.points);
	}

	// unnamed value case
	// 	using the tagged uinion tag/enum name and load value as struct assignment.
	// 	the idea is the tagged union is a value of the tage and a value of the type underneath it.
	// 	so why not match specific cases where we want tage with a specific value.
	// 	does this syntax collide with any other cases?
	case {.option, .Editable} {
		schematic.log("this file is editable\n");
	}

	// partial unnamed value case
	// 	using the `_` symbol to indicate that we don't care about the actual value.
	case {.symbol, .{.{5, _}, _} {
		schematic.log("this symbol is on x = 5\n");
	}

	// multiple unnamed type cases
	case .comment, .hint;

	// multiple unnamed value cases
	case {.comment, _}, {.hint, _};


	case {.option, .Editable} {
		schematic.log("this file is editable\n");
	}


	// Using The Declaration Syntax For Better Coherence In The Language
	// -----------------------------------------------------------------
	// We can use the case followed by a named/unnamed variable declaratoin/assignment expression
	// 	this is meant more to signify that the tag and avlue are the values asigne to the case no the types.
	// 	basic

	// named type case
	// 	this nameing could be applied to the cases wher a range of values is used
	case symbol : .Symbol {
		validate(symbol.primatives);
		transformt(symbol.position);
	}


	// named value case
	// 	the .{} syntax is the assignment to expected type of the tagged union pair of values.
	case editableOption :: {.option, .Editable} {
		editableOptin = false;
	}


	// partial named value case
	// 	using the `_` symbol to indicate that we don't care about the actual value.
	case symbol :: {.symbol, {{5, _}, _}} {
		schematic.log("this symbol is on x = 5 and y = {symbol.pos.y}\n");
	}


	// jointly named type cases
	case ingnoredInstances : .spiceCommand, .lable {
		print("Ignored the instance at position {}\n", ignoredInstance.pos);
		ignoredInstancesCount++;
	}


	// jointly named value cases
	case ingnoredInstances :: {.option, .Editable}, {.link, "~/"} {
		print("Ignored the instance at position {}\n", ignoredInstance.pos);
		ignoredInstancesCount++;
	}


	// destructuring named values
	// 	we don't want to keep doing the symbol.member access pattern
	case . : .Symbol {
		validate(primatives);
		transformt(position);
	}

	// but what if we want to rename the members inside the value?
	// 	is this even usefull?
	// 	the example in rust does make sense as the value itself wan't named.
	//	I dont' like this yet.
	case {prim, pos} : .Symbol {

	}


	// single statement cases
	case .joint remove(@ joint);
	case {.option, .Editable} editableOptin = false;
	case joint 	    :  .joint                remove(@ joint);
	case editableOption :: {.option, .Editable} editableOptin = false;

	// empty code cases.
	// 	this is helpfull to make sure no problems with the other case but not yet handeling them.
	case .joint;
	case .optio;

	// in case the case statement have only one statement then we could just ignore the curly braces
	case joint : .joint remove(@ joint);


	case _ {
		print("this is not something to be bothered with\n");
	}
}


