// How a state machine or jump actually looks in Abstract syntax:
// Software
interpreter_loop :: (bytecode : [] u8) -> () {
	pc : usize = 0;

	dispatch_start : label;

	if bytecode[pc] {
		case 0x01 { goto handle_add; }
		case 0x02 { goto handle_mul; }
		case 0x00 { return; }
	}

	handle_add  : label;

	// do add logic...

	pc++;
	goto dispatch_start;

	handle_mul : label;

	// do mul logic...

	pc++;
	goto dispatch_start;
}


// Hardware
StateMachine :: enum {
	IDLE;
	PROCESSING;
	FAULT;
}

run_controller :: (current_state : StateMachine) -> (next_state : StateMachine) {
	in current_state {
		case .IDLE {
			if start_signal then goto PROCESSING;
		}
		case .PROCESSING {
			if error_detected then goto FAULT;
		}
		case .FAULT {
			goto IDLE;
		}
	}
	return current_state;
}






