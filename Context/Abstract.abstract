// Scope Embedding
// -----------------------------------------------------------------
// Named module
basic :: #import("Software/basics.a");		// Loads a module an assign it to a compile-time name.
basic.print("Hello, World!");			// Using functions from the module.

// Embedded Module
. :: #import("Software/basics.a");		// Loads the module and put all of it's insides int he current file scope
print("Hello, World!");				// Using functions from the module.










// Types Composition
// -----------------------------------------------------------------
Adress :: struct {
	buildingNumber : string;
	street         : string;
	area           : string;
	city           : string;
	governance     : string;
	country        : string;
}

PersonalInformation :: struct {
	name   	       : string;
	salary         : s32;
	.              : Adress;
}


person : PersonalInformation = {
