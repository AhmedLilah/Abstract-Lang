// -----------------------------------------------------------------
// Should No-Discard be the default for return types? (no, make it opt-in)
function :: () -> #must s32 {
	...
}

main :: () {
	// Error : unused return type.
	funciton();

	// unnamed valid use of return type.
	res := function() + 5; // the value is used directly in the expression.

	// Ok. Intentionally discarding return type.
	_ :: function();
}










// -----------------------------------------------------------------
// Named Return Types As Local Variable Names
// 	 It should help with HDL context as the named types in the return block is also net/ports names and in analog this should help with inout types and the face that we can use the same syntax as replacement for spice netlists.
// 	 Should I support named return types to be locally named variables in the scope of any procedural block and if they get assigned then there should be no need to use the return keyword to return or it could be optional?
// 	 How might that affect the returned value if the procedural block might error or return a valid value or if the procedural block might return an optional type?
// 	 I currently believe that this problem is in small part a syntax one and the majority of the implications will be on the semantics side.
// 	 How would that collide with the idea that any named return type introduced  will be treated as if it was independently declared?
// 	 How would this collide with the idea of errors and optional return types.

// Named returned type as local variables
name :: (A, B) -> (C : s32, D : s32) {
	C, D :: fullAdder(A, B);
}

// Use of `return` With Named returned type
name :: (A, B) -> (C : s32, D : s32) {
	C, D :: fullAdder(A, B);
	return;
}












// -----------------------------------------------------------------
// Using `_` For Uninitialized Variables
//      value initialized variable.
x := 5;

//      default initialized variable.
y : s32;

//      uninitialized variable.
z : s32 = _;




// -----------------------------------------------------------------
// Using `_` For Discarding Return Values
function :: (a : s32, b : s32) -> (x : s32, y : s32) {

}

// use the first return type and ignore the orther.
x , _ := function(3, 5);






// -----------------------------------------------------------------
// Using `_` For Default Value Parameters
// function definition with default value parameters.
proc :: (param1 : type1 = 5, param2 : type2 = 7, paramn : typen = valuen) {

}

// calling
proc(_, 56, _);




// -----------------------------------------------------------------
// Using `_` For Generic Types/Parameters
// generic function definition
proc :: (A : _ , B : A ) -> (C : A) {
	C = A + B;
}

// generic sturct definition
Struct :: {
	A : _ ;
	B : _ ;
	C : B ;
}
































// Type Decorators
// -----------------------------------------------------------------
volatile 	// Marking a variable as volatile means that it could potentially be modified during execution in a scope that all outside of the program normal execution.
static		// no idea yet what to use it for but will reserve it.
global		// no idea yet what to use it for but will reserve it.
thread		// probably be used for thread locality of data.
extern		// This will probably be used to define externally defined parts of the API?
ristricted      // Not yet decided.
unique          // Used to indicate taht a pointer is not used in any other place in the code similar to the strict keyword in C.
inline          // used to make sure that a function execution is going to be inlined in the caller site.
call            // used to make sure that a function execution is going to be a function call.
destinct	// used to define types form other ones that are opposite to aliases.


// volatile
// -----------------------------------------------------------------
//	this prevents the compiler from using optimization assumptions and resuse assumptions
//	as it doesn't know the variable could be changed between value uses.
volatileVariable : volatile u8;

// 	this could also be used on function as their pointers may be stored at a specific
//	hardware register or controlled by hardware in some sense
volatileFunction :: volatile () -> (DataType) {}

// static
// -----------------------------------------------------------------

// global
// -----------------------------------------------------------------

// thread
// -----------------------------------------------------------------

// extern
// -----------------------------------------------------------------

// ristricted
// -----------------------------------------------------------------

// unique
// -----------------------------------------------------------------
// 	this allows the compiler to have some assumptions about the pointer
//	these assumptions make it better for performance optimiztaions.
//	this is similar tot he restrict keyword in c.
performanceImportantFunction :: (pointerToData : unique @ BigStruct) {}

data : BigFatStruct;

preformanceImportantFunction(@ BigFatStruct);


// inline
// -----------------------------------------------------------------
performanceImportantFunction :: (data : []) -> (bool) {}

data :: {1, 2, 3, 4, 5}

// defulat case
// 	this will be left to the compiler to decide weather or not to do the inlining.
preformanceImportantFunction(data);

// 	this will always inline the funtion at the caller's place.
inline preformanceImprotantFunction(data);

// If we know that it should always be inlined and not a function call in any senario we could
//	add the modifer/decorator on the function definintion itself.
//	this will prevent the complier from calling and will give an error if the user
//	tried to force call manually.
sizeImprotantFunction :: call (data : []) -> (bool) {}


// call
// -----------------------------------------------------------------
sizeImportantFuction :: (data : []) -> (bool) {}

data :: {1, 2, 3, 4, 5}

// defulat case
// 	this will be left to the compiler to decide weather or not to do the inlining.
sizeImportantFuction(data);

// 	this will always make a funtion call at the caller's place no inlining.
call sizeImportantFuction(data);

// If we know that it should always be called and not inlined in any senario we could
//	add the modifer/decorator on the function definintion itself.
//	this will prevent the complier from inlining and will give an error if the user
//	tried to force inline manually.
sizeImprotantFunction :: call (data : []) -> (bool) {}


// destinct
// -----------------------------------------------------------------
	// used to define types form other ones that are opposite to aliases.
	// even though they are the same type a compiler refuses to use one inplace of the other
	// in the normal case the the if condition will evaluate to true.
LogicAnswer :: bool;
if typeof(LogicAnswer) == typeof(bool) {
	compiler.log("same type");
} else {
	compiler.log("different types");
}

// using the destinct keyword the if condition will evaluate to false.
LogicAnswer :: destinct bool;
if typeof(LogicAnswer) == typeof(bool) {
	compiler.log("same type");
} else {
	compiler.log("different types");
}










