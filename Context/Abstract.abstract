// Loop Controls
// -----------------------------------------------------------------
// Break free of the scoop of the current loop and continue the program execution flow.
continue;

// Skips the current loop iteration.
break;

// Skip the current iteration of the loop specified by the name given that we’re currently inside this loop block.
continue loopName;

// Break free of the scoop of the named loop and continue the program execution flow.
break loopName;










