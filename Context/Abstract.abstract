// Solving the bit/byte field definition problem will solve the array vs range bit field
// -----------------------------------------------------------------
//      range style bit filed
// 	these example shows dealing with bit fileds only but we can use the same syntax
// 	for dealing with byte fields when we deal with software as CPUs usually have fine-
//	tuining for accessing byts not bits and we wnant to support that also.
and :: (A: [7..0] bit, B: [7..0] bit) -> (Y: [7..0] bit) {

}

RAM :: [1024] [63..0] bit;

a, b : [63..0] bit;

con :: (H : [7..0] bit, L : [7..0]) -> (A : [15..0]) {
	A = { .. H, .. L}; // H[0], ..., H[n], L[0], ..., L[n];
	return;
}




// Array Slicing
// -----------------------------------------------------------------
// the slcing operator ':' is range inclusive.
arr := [1, 2, 3, 4, 5, 6]; 	// {1, 2, 3, 4, 5, 6}
arr := {1, 2, 3, 4, 5, 6}; 	// {1, 2, 3, 4, 5, 6}

slice := arr[1:4];		// {2, 3, 4, 5}




// Bit Field Slicing
// -----------------------------------------------------------------
//      Should field slicing be done with the same operator used
//      for the the bit field defining?
address :  [7..0] = 0b1111_0000;
H       := address[7:4]; // 0b1111
L       := address[3:0]; // 0b0000

// or
address :  [7..0] = 0b1111_0000;
H       := address[7..4]; // 0b1111
L       := address[3..0]; // 0b0000




// Using .. for arrays destructuring
// -----------------------------------------------------------------
rng : [8] s64 = {0, 1, 2, 3, 4, 5, 6, 7};       // {0, 1, 2, 3, 4, 5, 6, 7}
rng = { .. rng, 50, 100 };                      // {0, 1, 2, 3, 4, 5, 6, 7, 50, 100}
rng = { .. rng[0:5], 12, 14};                   // {0, 1, 2, 3, 4, 5, 12, 14}




// Using .. for fields destructuring
// -----------------------------------------------------------------
//      This is super usefull for bit manipulation for hardwaer mode and for software usages also
address :  [7:0] = 0b1111_0000;
H       := address[7..4]; // 0b1111
L       := address[3..0]; // 0b0000

vAddress : [7:0] = {..L, ..H} // 0b0000_1111










