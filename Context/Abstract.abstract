// Different Symbols For Pointer Referencing/Dereferencing
// -----------------------------------------------------
// Different syntax for Address of Value vs Value in Address
// @ for getting the address
// $ for getting the value
a := 420;               // a variable of type f32
ptr := @ a;             // a pointer to f32
$ptr = 69;              // assigning the value 69 to the variable a pointed to by ptr

ptrPtr := @ ptr;        // a pointer to a pointer to f32
$($ptrPtr) = 42;        // assigning the value 42 to the variable a pointed to by ptr pointed to by ptrPtr

ptrPtr = @@a;           // this creates a temporary pointer stored in the stack to make a pointer to this pointer.
$$ptrPtr = 0;           // this double dereference the double pointer and assign to it.

// Example for deciding the place of @ and $
S :: {
	x, y : f32;
}

s := S{x = 1.0, y = 2.0};

sp := @s;

// for type pointers member accessing implicitly dereferences the pointer.
sp.x = 5.0;
sp.y = 0.0;

//      and if we want the struct itself we would do this
//              write when needed.
sc := $sp;













