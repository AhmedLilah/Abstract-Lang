// Constants/Variables Declaration/Definition
// -----------------------------------------------------------------
// The constant and variable combined declartion and assignment opertors `::` and `:=`
// can be used to declare and assign constants and variable according to the general
// form of <identifier(s) named(s)> : <type(s)> : or = <value(s) or expression(s)>;

a      	:: v;		// This defines a compile time constant and infer the type from the initialization value.
a 	:  T : v;	// This defines a compile time constants by specifying the type before assigning the value.
a, b 	:: v;		// This defines multiple compile time constants and infer the type from the initialization value.
a, b 	:: v, v;	// This defines multiple compile time constants and infer the type from the initialization values.
a, b 	:  T, T : v, v;	// This defines multiple compile time constants by specifying the types before assigning the values.

_ 	:: v;		// Discarded value compile time constant.
_, a 	:: v, v;	// This discard the value corresponding the `_` operator.

a 	:= v;		// This defines a variable and infer the type from the initialization value.
a 	:  T = v;	// This defines a variable and by specifying the type before assigning the value.
a, b 	:= v;		// This defines multiple vairables and infer the type from the initialization value.
a, b 	:= v, v;	// This assigned each identifier to the corresponding value and give it the inferred type of the value.
a, b 	:  T, T = v, v;	// This defines multiple variables by specifying the types before assginig it the values.

a 	:  T;		// This defines a default initialized variable and specifies it's type.
a 	=  v;		// This assigns a value to a pre-defined variable.

_ 	:= v;		// Discarded value variable
_, a 	:= v, v;	// This discard the value corresponding the `_` operator.



// Note:
// -----------------------------------------------------------------
//	What if I want to assign from a function that have multiple return types
//	and most of them are newly defined but one or more was breviously defined

// Use Go like `:=`
// 	if and old variable name is used with a new one it declares the new one and reuses the old.
// 	it only throws the error if nor new names are present.
a    := 5; 		// OK: first time.
a    := 10; 		// Error: re declaration.
a, b := 6, 9;		// Ok: mixed declaration and reuse.


// Example 1
f : () -> (s32, f32, s64, f64) {
	0, 1.0, 2, 3.0;
}
a, d : s32, f64;
a, b, c, d := f();

// Example 2
f1 :: (a, b : f32) -> (res : f32, ok : bool) { /* code */ }
f2 :: (a, b : f32) -> (res : f32, ok : bool) { /* code */ }

res1, ok := f1();
if ok {
	/* Code */
}

res2, ok := f2();
if ok {
	/* Code */
}














