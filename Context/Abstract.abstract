// Aliases
// -----------------------------------------------------------------
// aliases are just name variants for the same thing.
// they are not reference or pointers.
// It's literally another name.
Vec4    :: {
	x, y, z, w : f32;

	// defining aliases for each field to allow flexability based on the used usage context.
	r, h, R :: alias x;
	g, s, I :: alias y;
	b, l, v :: alias z;
	a    	:: alias w;
}

RGBA, HSLA, HSVA, Quat :: alias Vec4;

vec4    :: (value : f32) -> (vec : Vec4) {
	vec.x, vec.y, vec.z, vec.w = value;
	return;
}

rgba, hsla, hsva, quat :: alias vec4;





// Subtype Aliasing
// -----------------------------------------------------------------
// The problem with aliasing in the struct itself is that if we have
// aliases that use the same name but in different order it makes it
// a problem to have aliases of both in the struct.
// Example: RGB vs BGR color vectors.
// 	Both should be aliases to the same Vec3 struct. but due to the
// 	different memory order we cant have to place in the same struct
// 	witht the same name.
Vec4    :: {
	x, y, z, w : f32;

	// defining aliases for each field to allow flexability based on the used usage context.
	r, h, R :: alias x;
	g, s, I :: alias y;
	b, l, v :: alias z;
	a    	:: alias w;
}


// This now forces the re aliasing of sub-aliases.
BGRA :: alais Vec4 {
	// defining aliases for each field to allow flexability based on the used usage context.
	b, h, R :: alias x;
	g, s, I :: alias y;
	r, l, v :: alias z;
	a    	:: alias w;
}

// These have the same internal types and aliases as the original vector.
RGBA, HSLA, HSVA, Quat :: alias Vec4;

vec4    :: (value : f32) -> (vec : Vec4) {
	vec.x, vec.y, vec.z, vec.w = value;
	return;
}

rgba, hsla, hsva, quat, bgra :: alias vec4;

