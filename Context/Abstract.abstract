// UFCS Vs Methods Receivers
// -----------------------------------------------------------------
// 	This was first explored a long time a go and i'm still not sure weather or not
// 	it should still be a thing at the end of this. it might help a while with some
// 	syntax suggar but is it worth the hassle and other problems it's gonna make w-
// 	ith obfiscation and function calling order and prioritization.
2DPoints :: {
	x, y : s8;
}

// declaring a method
shift :: (point : inout 2DPoint) (xShift : s8, yShift : s8) {
	point.x = point.x + xShift;
	point.y = point.y + yShift;
}

// declaring a method and using the name decomposition feature
shift :: (. : inout 2DPoint) (xShift : s8, yShift : s8) {
	x = x + xShift;
	y = y + yShift;
}

main :: () {
	point : 2Dpoint;
	point.shift(5, 6);
}











// Closures
// -----------------------------------------------------------------
main :: () {
	// local constant
	X, Z :: 5;

	// function
	function :: (A : f64, B : f64, X : f64, Z : f64) -> (Y : f64) {
		Y = (A + B) / X * Z;
	}

	// closure syntax 1
	// implicit capture
	closure :: (A : f64, B : f64) => (Y : f64) {
		Y = (A + B) / X * Z;
	}

	// closure syntax 2
	// explicit capture 1
	closure :: (A : f64, B : f64) -> (Y : f64) [@ X, $ Z, *] {
		Y = (A + B) / X * Z;
	}

	// closure syntax 3
	// explicit capture 2
	closure :: (A : f64, B : f64) [@ X, $ Z, *] -> (Y : f64) {
		Y = (A + B) / X * Z;
	}

	// closure syntax 4
	// explicit capture 3
	closure :: (A : f64, B : f64) -> (Y : f64) [. : @ X, . : $ Z, *] {
		Y = (A + B) / X * Z;
	}

	// closure syntax 5
	// explicit capture 4
	closure :: (A : f64, B : f64) -> (Y : f64) using @ X, $ Z, * {
		Y = (A + B) / X * Z;
	}


	res1 :: function(4.2, 6.9, X, Z);
	res2 :: closure(4.2, 6.9);

	print("res1 : {}, res2 : {}", res1, res2);
}


















