// Simple Flag
// -----------------------------------------------------------------
cpu_flags :: flag u8 {
	NONE :: 0;            // 0b0000_0000
	CARRY;                // 0b0000_0001
	ZERO;                 // 0b0000_0010
	NEGATIVE;             // 0b0000_0100
	OVERFLOW;             // 0b0000_1000
	PARITY;               // 0b0001_0000
	AUXILIARY;            // 0b0010_0000
	TRAP;                 // 0b0100_0000
	DIRECTION;            // 0b1000_0000
}


// Non-exhaustive flag
// -----------------------------------------------------------------
PortFlags :: flag u8 {
	Off;                    // 0B0000_0000

	// Directionality       // 0B0000_XXXX
	Input;                  // 0B0000_0001
	Output;                 // 0B0000_0010
	InOut;                  // 0B0000_0100
	HighZ;                  // 0B0000_1000

	// Port Type
	Digital;                // 0B0001_0000
	Analog;                 // 0B0010_0000
	PWM;                    // 0B0100_0000
	Clk;                    // 0B1000_0000

	// Making the flag non-exhuastive to allow other extentions in the future.
	_;
}

analogInput :: PortFlags.Input | .Analog;






