ProtState :: enum {
	Input;
	Output;
	Inout;
	HighZ;
}



// The type fo the enum is optional after the enum keyword
// -----------------------------------------------------------------
ProtState :: enum u8 {
	Input;
	Output;
	Inout;
	HighZ;
}


// Non-exhuastive enums
// -----------------------------------------------------------------
// 	This means that the langue won't prvent the user from using values
// 	form the underlying type in the enum calling or assignments for u-
// 	se cases which the user can't or doesn't want to specify the enti-
// 	re range of the values in the enum.
// 	Defining the underlying type here is a must.
NE :: enum u8 {
	E1 = 0;
	E2;
	E3;
	_;
}

Card :: enum u8 {
	// Ranks
	One :: 0;               // 0b0000_0001
	Two;                    // 0b0000_0010
	Three;                  // 0b0000_0011
	Four;                   // 0b0000_0100
	Five;                   // 0b0000_0101
	Six;                    // 0b0000_0110
	Seven;                  // 0b0000_0111
	Eight;                  // 0b0000_1000
	Nine;                   // 0b0000_1001
	Ten;                    // 0b0000_1010
	Jack;                   // 0b0000_1011
	Queen;                  // 0b0000_1100
	King;                   // 0b0000_1101

	// Suits
	Spades :: 16;           // 0b0001_0000
	Hearts;                 // 0b0010_0000
	Diamonds;               // 0b0011_0000
	Clubs;                  // 0b0100_0000

	// Making the enum non-exhuastive to allow rank-suit compinations
	_;
}

aceOfSpades :: Card.One | .Spades;






