	salary         = 2K,
	buildingNumber = "1",
	street         = "main",
	area           = "5th Setelment",
	city           = "New Cairo",
	governance     = "Cairo",
	country        = "Egypt"
};










// Function Parameter Decomposition
// -----------------------------------------------------------------
RGB :: {
	r, g, b : f32;
}

modifyBrightness :: (. : inout structName, l : f32) {
	r = r * l;
	g = g * l;
	b = b * l;
}

backGroundColor : RGB = {0.2, 0.2, 0.2};

modifyBrightness(backGroundColor, 1.5);











// Automatically Invoked Struct Member Defining Functions
// -----------------------------------------------------------------
// 	This is a way to use the deconstructing embedding operator
// 	to auto invoke functions that return a type that is then used
// 	as a struct member and directly accessed.
EntityType      :: enum u8 {
	Entity;
	Door;
	Human;
}

Entity          :: {
	type    :  EntityType;
	vTable  :  [] @;
	x, y, z :  f32;
	.       :: (. : @ Entity) -> @ EntityVTable {
		return vTables[type];
	}
}

DoorState       :: enum u8 {
	Closed;
	Open;
}

Door            :: {
	.       :  Entity;
	state   := DoorState.Closed;
}

Human           :: {
	.       :  Entity;
	name    := "unnamed";
}

EntityVTable    :: {
	init    :: (. : @ Entity) {}
	print   :: (. : @ Entity) {}
}

DoorVTable      :: {
	init    :: (. : @ Door) {
		x, y, z = 3.1415;
		state = .Open;
	}
	print   :: (. : @ Door) {
		print("Door:\n");
		print("\tis at: ({}, {}, {})\n", x, y, z);
		print("\tis   : {}\n", state);
	}
}

HumanVTable     :: {
	init    :: (. : @ Human) {
		x, y, z = 3.1415;
		name = "Ahmed S. Lilah"
	}
	print   :: (. : @ Humand) {
		print("Human:\n");
		print("\tis at: ({}, {}, {})\n", x, y, z);
		print("\tname : \"{}\"\n", name);
	}
}

entityVTable    : EntityVTable;
doorVTable      : DoorVTable;
humanVTable     : HumanVTable;

vTables : [3] @ void = {auto @enityVTable, auto @doorVTable, auto @humanVTable};
vTables : [3] @ Any  = {auto @enityVTable, auto @doorVTable, auto @humanVTable};

door    := alloc(Door);
human   := alloc(Human);

door.print(door);
door.init(door);
door.print(door);

human.print(human);
human.init(human);
human.print(human);



// rethinking this.
// ---------------------------------------------------------
Entity          :: #(V : T) {
	.       :: V;
	x, y, z :  f32;
}

DoorState       :: enum u8 {
	Closed;
	Open;
}

Door            :: #(V : T) {
	.       :  Entity(V);
	state   := DoorState.Closed;
}

Human           :: #(V : T) {
	.       :  Entity(V);
	name    := "unnamed";
}

EntityVTable    :: {
	init    :: (. : @ Entity) {}
	print   :: (. : @ Entity) {}
}

DoorVTable      :: {
	init    :: (. : @ Door) {
		x, y, z = 3.1415;
		state = .Open;
	}
	print   :: (. : @ Door) {
		print("Door:\n");
		print("\tis at: ({}, {}, {})\n", x, y, z);
		print("\tis   : {}\n", state);
	}
}

HumanVTable     :: {
	init    :: (. : @ Human) {
		x, y, z = 3.1415;
		name = "Ahmed S. Lilah"
	}
	print   :: (. : @ Humand) {
		print("Human:\n");
		print("\tis at: ({}, {}, {})\n", x, y, z);
		print("\tname : \"{}\"\n", name);
	}
}

entityVTable    :: EntityVTable {};
doorVTable      :: DoorVTable   {};
humanVTable     :: HumanVTable  {};

door    := alloc(Door(doorVTable));
human   := alloc(Human(humanVTable));

door.print(door);
door.init(door);
door.print(door);

human.print(human);
human.init(human);
human.print(human);














