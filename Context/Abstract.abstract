// `::` and `:=` are allowed once per scope for each name return type.
// -----------------------------------------------------------------
// if we want to use `::` for wire assignment and `:=` for reg/FF assignment how would it be without making a case that is impossible in SW mode?

ConfigCommand :: struct {
	target_port  : u8;
	baud_rate    : u32;
}

DataPayload :: struct {
	length       : u16;
	checksum     : u16;
}

PacketType :: enum union {
	config       : ConfigCommand;
	data         : DataPayload;
	reset        : types.ResetSignal;
	fault        : types.FaultReport;
}

RouterState :: enum {
	IDLE;
	RECEIVING;
	PROCESSING;
	ERROR_STATE;
}

PacketRouterController :: (clk : clock, reset_n : bit, packet_in : PacketType) -> (route_valid : bit, destination : u8, error_code : u16) {
	is_urgent     :: packet_in.tag == .config;
	checksum_pass :: verify_packet_integrity(packet_in);

	current_state  := RouterState.IDLE;
	packet_counter := 0u16;
	fault_logged   := false;

	route_valid    := 0;
	destination    := 0x00;
	error_code     := 0x0000;

	if posedge(clk) {
		if not reset_n {
			// Synchronous Reset
			current_state  = .IDLE;
			packet_counter = 0;
			fault_logged   = false;
			route_valid    = 0;
			destination    = 0x00;
			error_code     = 0x0000;
		} else {

			// Default cycle defaults to prevent latch inference
			route_valid = 0;

			// FSM State Dispatch using the 'in' block for plain enums
			if current_state {

				case .IDLE {
					if checksum_pass {
						current_state = .RECEIVING;
					} else {
						current_state = .ERROR_STATE;
						error_code    = 0xDEAD;
					}
				}

				case .RECEIVING {
					// Pattern matching on the PacketType enum union with explicit payload binding (cfg, dat, etc.)
					if packet_in {

						case cfg : .config {
						    destination   = cfg.target_port; // Explicitly bound payload variable
						    route_valid   = 1;
						    current_state = .PROCESSING;
						}

						case dat : .data {
						    packet_counter = packet_counter + 1;
						    destination    = 0xFF; // Broadcast
						    route_valid    = 1;
						}

						case .reset {
							current_state = .IDLE;
						}

						case .fault {
							fault_logged  = true;
							current_state = .ERROR_STATE;
						}
					}
				}

				case .PROCESSING {
					priority_level := if is_urgent then 3 else 1;

					if packet_counter > 1024 {
						current_state  = .IDLE;
						packet_counter = 0;
					}
				}

				case .ERROR_STATE {
					route_valid = 0;
					if not fault_logged {
						error_code = 0xEE01;
					}
				}
			}
		}
	}
}