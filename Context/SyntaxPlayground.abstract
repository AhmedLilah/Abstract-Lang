// Static arrays
arr           	:= {1.0, 2.0, 3.0, 4.0}; 				// the type is [4] f64.
arr 		:= {.. (1.0:4.0)};					// the type is [4] f64.
arr           	:  [4] f64 = {1.0, 2.0, 3.0, 4.0}; 			// the type is [4] f64.

// 	what if we want to say it's a static array but make these size infered from the data or define it at the data?
// 		becuse we want to be explicit in it.
arr 		:  [.] f64 = {1.0, 2.0, 3.0, 4.0}; 			// the type is [4] f64.
arr 		:= [.] f64 {1.0, 2.0, 3.0, 4.0}; 			// the type is [4] f64.




// Slices
slice         	:= arr[1:2]; 						// the type is [4] f64.
arr           	:  [] f64 = {1.0, 2.0, 3.0, 4.0}; 			// the type is [4] f64.
arr           	:= [] f64 {1.0, 2.0, 3.0, 4.0}; 			// the type is [4] f64.




// Dynamic Arrays
da 		:= alloc([100] f64);					// the type is [_] f64.
da 		:  [_] f64 = alloc([100] f64);				// the type is [_] f64.
da 		:  [_] f64 = {1.0, 2.0, 3.0, 4.0};			// the type is [_] f64.
da 		:= [_] f64 {1.0, 2.0, 3.0, 4.0};			// the type is [_] f64.

// Question:
// 	Should we use the "[...]" for dynamic arrays?
da 		:= alloc([100] f64);					// the type is [...] f64.
da 		:  [...] f64 = alloc([100] f64);			// the type is [...] f64.
da 		:  [...] f64 = {1.0, 2.0, 3.0, 4.0};			// the type is [...] f64.
da 		:= [...] f64 {1.0, 2.0, 3.0, 4.0};			// the type is [...] f64.

// 	Should we use the "[?]" for dynamic arrays?
da 		:= alloc([100] f64);					// the type is [?] f64.
da 		:  [?] f64 = alloc([100] f64);				// the type is [?] f64.
da 		:  [?] f64 = {1.0, 2.0, 3.0, 4.0};			// the type is [?] f64.
da 		:= [?] f64 {1.0, 2.0, 3.0, 4.0};			// the type is [?] f64.



// what if we want to define the indexing type?
IndexEnum :: enum {
	first;
	second;
}

N :: 1024;

defaultIndexedStaticArray  : [N            ];
integerIndexedStaticArray  : [N : ssize    ];
enumIndexedStaticArray     : [N : IndexEnum];

defaultIndexSlice	   : [             ];
integerIndexSlice	   : [  : ssize    ];
enumIndexedSlice 	   : [  : IndexEnum];

defaultIndexedDynamicArray : [_            ];
integerIndexedDynamicArray : [_ : ssize    ];
