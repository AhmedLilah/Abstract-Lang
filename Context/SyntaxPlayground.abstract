// 1. Define custom metadata structs (Normal code)
PinType :: struct {
	kind : enum { signal; power; ground; clock; };
}

Domain :: struct {
	name       : string;
	max_voltage : f32;
}

MechanicalPin :: struct {
	cad_reference : string;
	pin_number    : u32;
}


// 2. Attach them to variables, parameters, or functions using single quotes
Amp :: (
	InP, InM   : input  Electrical 'PinType{ .signal }',
	VDD, SSS   : inout  Electrical 'PinType{ .power  }'
) -> (
	OutP, OutM : output Electrical 'PinType{ .signal }'
) 'Domain.{ "Analog", 5.0 }' {

	// Local variable with layout/parasitic metadata notes
	// The compiler type-checks that 'max_voltage' expects an f32, etc.
	feedback_cap : capacitor 'PinType{ .signal }' = 2.5p;
}





// Abstract template / interface definition
// The compiler enforces that any concrete instantiation MUST provide a PinType value for InP.
GenericAmp :: (
	InP : input Electrical 'PinType',
	VDD : inout Electrical 'PinType'
) -> (
	OutP : output Electrical 'PinType'
) {
	    // ...
}

// Concrete instantiation later, where the deferred metadata values are filled in:
my_amp := inst GenericAmp(
	InP  = signal_line 'PinType{ .signal }',
	VDD  = vcc_rail    'PinType{ .power   }',
	OutP = output_net  'PinType{ .signal }'
);




// A compile-time meta-block that runs during compilation
generate_spice_netlist :: (module_symbol : type) -> string {
	netlist_buffer := "";

	// '#meta' queries all metadata notes attached to the module's parameters
	for param in #meta(module_symbol).parameters {
		// You can pattern-match or check note types at compile time!
		pin_info := param.find_note(PinType);

		if pin_info {
			match pin_info.kind {
				case .power  { netlist_buffer += ".power_node {}\n".format(param.name); }
				case .signal { netlist_buffer += ".node {}\n".format(param.name); }
				else         {}
			}
		}
	}

	return netlist_buffer;
}


