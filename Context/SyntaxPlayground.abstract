// A compile-time function to validate net constraints
validate_analog_pins :: (module_symbol : type) -> void {

    // Iterate over parameters
    for param in #meta(module_symbol).parameters {

        // Using .# to check if a 'PinType' note is attached and evaluate it at compile time
        if param.#PinType.kind == .power {
            // Ensure power pins have a valid voltage domain defined via another note
            voltage_limit := param.#Domain.max_voltage;

            if voltage_limit <= 0.0 {
                compiler.error("Power pin '{}' must have a valid max_voltage domain!", param.name);
            }
        }
    }
}





















