//      Using a keyword for making statements pass through the hygenic macro to parent scopes.
//      the keyord could be applied to a statement or a scope.
//              trasparent
//              permiable
//              translucent
scoped_gard_lock :: macro (vriable : _) {
	transparent {
		lock(variable);
		defer unlock(variable);
	}
