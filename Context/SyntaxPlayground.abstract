// Adding units, description, nature, and/or types to the hardware types
// -----------------------------------------------------------------
// This is ment to define somethings  like the nature, discipline, unit,
// description, type, flow, and/or potential that exist in Verilog-AMS
// languages and VHDL.

// this could be done either by addin compile time notes.

// or these could be just simple structs that are expected in a meta struct.

// there are different way to model this
// 	1. modleing nature types as a tagged type.
// 	2. modling flow and potential individually
Nature :: #(T: _ = f32) {
	value       : T;
	unit	    : string;
	description : string
}

Flow :: #(T: _ = f32) {
	., as : Nature(T);
}

Potential :: #(T: _ = f32) {
	., as : Nature(T);
}

Discipline :: #(F : as Flow, P : as Potential) {
	#expand { makeFirstLetterLowerCase(type(F).name) } : F;
	#expand { makeFirstLetterLowerCase(type(P).name) } : P;
}

Voltage :: Potential = .{unit = "volt", description = "electrical potential"};
Current :: Flow	     = .{unit = "amp",  description = "electrical current"  };

Electrical :: Discipline(Voltage, Current);


amplifier :: #(gain : f64) (in_p : Electrical, in_m : Electrical) -> (out : Electrical) {
	$v(out) = gain * (v(in_p) - (v(in_m));
	return;
}

