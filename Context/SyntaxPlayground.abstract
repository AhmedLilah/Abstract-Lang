// Value Range Specification
// -----------------------------------------------------------------
// the idea is to set specific compile time guards on the values types can have.
// can this be done via the enums/unions?
//      we will need to revisit the the specific value non-integer enums for that.

// using the in keyword with the range ':' symbol.
output : f32 in 0.2:0.8;

// using the from to keywords.
output : f32 from 0.2 to 0.8;


// Questions:
// 	what if want to exclude values not set a specific range?

// using the "exclude" keyword to exclude values
output : f32 exclude 0;								// the value of output is 0.5

// using the "except" keyword to exclude values
output : f32 except 0;								// the value of output is 0.5


// Questions:
// 	what is the default value?
// 	How to set the default value?
// 	Should setting the default value be required then?

// having the lower end of the range by default
output : f32 in 0.2:0.8;							// the value of output is 0.2
output : f32 from 0.2 to 0.8;							// the value of output is 0.2

// using the "using" or "use" keywords to set the default value.
output : f32 in 0.2:0.8 use 0.5;						// the value of output is 0.5
output : f32 in 0.2:0.8 using 0.5;						// the value of output is 0.5
output : f32 from 0.2 to 0.8 use 0.5;						// the value of output is 0.5
output : f32 from 0.2 to 0.8 using 0.5;						// the value of output is 0.5


// Questions:
// 	can we set the values in mutlpte ranges?

// using the in keyword with the range ':' symbol.
output : f32 in -0.8:-0.2, 0.2:0.8;

// using the from to keywords.
output : f32 from  -0.8 to -0.2, from 0.2 to 0.8;


// Questions:
// 	can we use all of them together?

// combinig all of it together.
output : f32 in -0.8:-0.2, 0.2:0.8 exclude -0.4, 0.4 use 0.5;			// the value of output is 0.5
output : f32 in -0.8:-0.2, 0.2:0.8 exclude -0.4, 0.4 using 0.5;			// the value of output is 0.5
output : f32 from 0.2 to 0.8, from 0.2 to 0.8 exclude -0.4, 0.4 use 0.5;	// the value of output is 0.5
output : f32 from 0.2 to 0.8, from 0.2 to 0.8 exclude -0.4, 0.4 using 0.5;	// the value of output is 0.5
output : f32 in -0.8:-0.2, 0.2:0.8 except -0.4, 0.4 use 0.5;			// the value of output is 0.5
output : f32 in -0.8:-0.2, 0.2:0.8 except -0.4, 0.4 using 0.5;			// the value of output is 0.5
output : f32 from 0.2 to 0.8, from 0.2 to 0.8 except -0.4, 0.4 use 0.5;		// the value of output is 0.5
output : f32 from 0.2 to 0.8, from 0.2 to 0.8 except -0.4, 0.4 using 0.5;	// the value of output is 0.5


