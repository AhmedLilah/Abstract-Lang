// defining compile time directives/operators that uses the operator,
//	pre, post, and decorators feature of the language.
or_else :: operator (lhs : pre ... _, rhs : post ... _) -> (res : ... _) {
	#if sizeDiff :: (lhs.size - 1) - rhs.size; sizeDiff > 0 {
		compiler.report(
			"Unmatched parameter number between LHS and RHS\n"
			"RHS is missing {sizeDiff} parameter\n"
		);
	} else if sizeDiff < 0 {
		compiler.report(
			"Unmatched parameter number between LHS and RHS\n"
			"RHS has an extra {sizeDiff} parameter\n"
		);
	}

	if type_of(lhs[lhs.size-1]) == bool and lhs[lhs.size-1] {
		return ..lhs;
	} else {
		return ..rhs;
	}
}



