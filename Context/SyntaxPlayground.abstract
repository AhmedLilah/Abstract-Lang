// Interchangable Parameter Type Decalaration
// -----------------------------------------------------------------
// When doing hardwaer it would be good if we can define that the I/O
// 	of a block could be treated as any of the same size types.
// This could be extended for softwar also
div :: (A : [31:0] bit | f32, B : [31..0] bit | f32) -> (Y : [31..0] bit | f32) {
	if B[30..0] == 0 {
		Y = nan;
	} else if A[30..0] == 0 {
		Y = 0.0;
	} else {
		// do the actual computation in here.
	}
}

