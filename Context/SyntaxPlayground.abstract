//      Should I make this a compiler directive?
//              #insert
//              using this will allow me to make a method aregument that take a place like jai does.
//              this will be the place or the body that the compiler will inject the code to.
scopedLock :: macro (mutex : @ Mutex) {
	#insert{
		lock(mutex);
		defer unlock(mutex);
	}
}

//      or, just use the keyword "insert" as is?
//              insert
scopedLock :: macro (mutex : @ Mutex) {
	insert{
		lock(mutex);
		defer unlock(mutex);
	}
}











