// Question:
// 	How can we combine all of the above and link the positional modifiers in the fucntion
// 	difinition with the positional data from the LaTeX syntax?
// 	Are we going to Handle LaTeX parsing?
// 		Probably to get the data.
// 	Should we use a keyword like "pos" or "positional" to indicate that the parameter is going to be positioned int he symbol?

`\int_{range}{equation}.d{variableName}` :: (range : pos Range, equation : pos Code, variableName : pos string)
					     -> (res : f64) {
	for #insert variableName in lowerLimit:stepSize:upperLimit {
		res += #insert equation;
	}
	return;
}

result := `\int_{0}^{10}{X^{2}}.d{x}`;







// The identifier string itself specifies the LaTeX pattern.
// {name : type} binds a positional parameter directly to its LaTeX structural slot.
`\int_{lower: pos f64}^{upper: pos f64}{equation: pos Code}d{var: pos string}` :: () -> (res: f64) {
	// Standard loops can now use stepSize (e.g., 0.001 default)
	for #insert var in lower..upper {
		res += #insert equation;
	}
	return res;
}









