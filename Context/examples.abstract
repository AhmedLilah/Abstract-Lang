// Object-Oriented Programming
//      Software - Hello World Program
#setModuleSyntaxMode("Software");
#setModuleProgrammingParadigm("objectOriented");

#import "Software/Paradigms/objectOriented.a";

ClassName :: {
	memberName1 : type1;
	memberName2 : type2;
}

ClassName.method1 :: (paramName1 : type1, paramName2 : type2) {
	// the `.` operator is used as a reference to self.
	.memberName1 = paramName1;
	.memberName2 = paramName2;
}

ClassName.oprator= :: (rhs : ClassName) -> ClassName {
	// the `.` operator is used as a reference to self.
	.memberName1 = rhs.memberName1;
	.memberName2 = rhs.memberName2;
	return .;
}

main :: () {
	print("Hello, World!");
}



