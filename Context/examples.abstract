        vec.x = n;
        vec.y = n;
        vec.z = n;
        return;
}

vec4       :: #(T : _) (n : T) -> (vec : Vec4(T)) {
        vec.x = n;
        vec.y = n;
        vec.z = n;
        vec.w = n;
        return;
}


vec2       :: #(T : _) (x : T, y : T) -> (vec : Vec2(T)) {
        vec.x = x;
        vec.y = y;
        return;
}

vec3       :: #(T : _) (x : T, y : T, z : T) -> (vec : Vec3(T)) {
        vec.x = x;
        vec.y = y;
        vec.z = z;
        return;
}

vec4       :: #(T : _) (x : T, y : T, z : T, w : T) -> (vec : Vec4(T)) {
        vec.x = x;
        vec.y = y;
        vec.z = z;
        vec.w = w;
        return;
}


vec3       :: #(T : _) (. : Vec2(T), z : T = 0.0) -> (vec : Vec3(T)) {
        vec.x = x;
        vec.y = y;
        vec.z = z;
        return;
}

vec4       :: #(T : _) (. : Vec2(T), z : T = 0.0, w : T = 0.0) -> (vec : Vec4(T)) {
        vec.x = x;
        vec.y = y;
        vec.z = z;
        vec.w = w;
        return;
}


vec4       :: #(T : _) (. : Vec3(T), w : T = 0.0) -> (vec : Vec4(T)) {
        vec.x = x;
        vec.y = y;
        vec.z = z;
        vec.w = w;
        return;
}


// global aliasing
Complex          :: alias Vec2;
RGB, HSL         :: alias Vec3;
RGBA, HSLA, Quat :: alias Vec4;

complex          :: alias vec2;
rgb, hsl         :: alias vec3;
rgba, hsla, quat :: alias vec4;

Tri2D            :: [3] Vec2;
Tri3D            :: [3] Vec3;

Quad2D           :: [4] Vec2;
Quad3D           :: [4] Vec3;

rgb_2_bw  :: #(T : _) (rgb : RGB(T)) -> BW(T) {
        bw : BW = _;
        bw.b = (0.2126*rgb.r + 0.7152*rgb.g + 0.0722*rgb.b);

}


rgb_2_hsl :: #(T : _) (. : RGB(T)) -> (hsl : HSL(T)) {
        max := math.max(r, g, b);
        min := math.min(r, g, b);

        hsl.l = (max + min) / 2.0;

        if max == min {
                hsl.h = 0.0;
                hsl.s = 0.0;
        } else {
                c := max - min;
                hsl.s = c / (1.0 - math.abs(2.0 * hsl.l - 1.0));

                switch max {
                        case r {
                                hsl.h = (g - b) / c + (g < b ? 6.0 : 0.0);
                        }
                        case g {
                                hsl.h = (b - r) / c + 2;
                        }
                        case b {
                                hsl.h = (r - g) / c + 4;
                        }
                        case _ {}
                }
        }

        hsl.h = math.round(hsl.h * 60.0);
        hsl.s = math.round(hsl.s * 100.0);
        hsl.l = math.round(hsl.l * 100.0);

        return;
}


rgb_2_hsl :: #(T : _) (rgb : RGB(T)) () -> (hsl : HSL(T)) {
        hsl = inline rgb_2_hsl(rgb);
        return;
}


main :: () {
        rgb  : RGB #(f32) = {.r = 0.100, .g=0.100, .b=0.100};
        hslM : HSL #(T = f32) = {.s = 0.500, .v = 0.800};

        hslM = rgb.rgb_2_hsl();
        hslF := rgb_2_hsl(rgb);
}






printableTrait :: (type : Type) -> bool {
        #if compiler.compile(print("{}", type); {
                return ture;
        }
        return false
}



print (formatString : string, args : ... Any) {
        #for @ arg := args {
                if not printable(arg.type) {
                        compiler.log("{} is not printalbe.\n", arg.type);
                }
        }
}










