// Software Programming
// ---------------------------------------------------------------------------
#import "Software/Basics.A"

// A procedural block that takes two 64-Bit Floating Point Inputs A and B and outputs the sum to the output Y.
add :: (A : f64, B : f64) -> (Y : f64) {
	Y = A + B;
}

// A struct representing a RGB colors.
RGB :: {
	// initializing the fields R, G, and B of type 8-bit unsigned integer.
	// adding the inout modifier so that struct members are publicly accessible.
	R, G, B : inout u8;
}

// instantiating an RGB struct named WHITE and assigning it the values for white.
WHITE : RGB : {.R = 255, .G = 255, .B = 255};

main :: () {
	print("White: R{WHITE.R}, G{WHITE.G}, B{WHITE.B}");
}





// Meta Programming
// ---------------------------------------------------------------------------
// importing the basics module into the global namespace.
#import “Software/Basics.A”

// import the math library and assigning it to the math namespace/identifer.
math :: #import “Software/Math.A”

calculateInverseSquareRoot :: (num : f64) -> result : f64 {
	result = 1 / math.sqrt(num);
}

main :: () {
	// usign the #run meta command to run the function at compile time.
	result :: #run calculateInverseSquareRoot(2);

	// printing the inverse square root to the standard output.
	print(“The inverse square root of 2 is {result}”);
}




// Digital Register Transfer Level**
// ---------------------------------------------------------------------------
// defining a 64-bit floating point adder.
add :: (A : f64, B : f64) -> Y : f64 {
	Y = A + B;
}

// defining an 8-bit multiplexer behaviorally.
mux :: (A : b8, B : b8, S : b1) -> (Y : b8) {
	match s {
		0b0 => Y = A;
		0b1 => {
			Y = B;
		}
	}
}


// Analog Behavioral Modeling
// ---------------------------------------------------------------------------
#import "Hardware/Analog.A"

// definig a current mirror with 10x ratio.
current_mirror :: (In : f64 electrical) -> (Out : f64 electrical) {
	Out = 10 * current(In);
}

// deining a voltage controlled voltage source
vcvs :: (sense_p : f64 electrical, sense_n : f64 electrical, gian : f64) -> (out_p : f64 electrical, out_n : f64 electrical) {
	out_p = voltage(out_n) + gain * (voltage(sense_p) - voltage(sense_n));
}


// Mixed-Signal Modeling**


// Circuit Netlisting
// ---------------------------------------------------------------------------
// A circuit definition for simple amplifier using a voltage controlled voltage source
// Lables could just be strings that are named net

Net :: string;
vsource :: (vPluse: inout Net, vMinus : inout Net, dc : f32 = 0, ac : f32 = 0, Type : SourceType) {
	dcVoltage(vPluse) = voltage(vMinus) + dc;
}
Vdd :: vsource ("vdd", "0", dc = 1.8);
Vin :: vsource ("vin", "0", ac = 1);
Amp :: vcvs ("vin", "0", "vout_internal", "0");
R_amp_internal :: res("vout_interanl", "vout");
C_amp_internal :: cap("vout", "0");