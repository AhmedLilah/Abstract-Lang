// HDL Context
// ---------------------------------------------------------------------------
//      Input ports are treated as nets so we can assign to them directly as in the Verilog-AMS family.
//      In Verilog and System-Verilog the input/output ports are directly treated as net in a spice netlist and they could be used to assign to them.

// Digital HDL
//      Hardware - Full Adder
digital          :: #import "Hardware/digital.a"

fullAdder :: (A : input, B : input, Cin : input) -> (Sum : output, Cout : output) {
	wire1     :: A xor B;
	wire2     :: A and B;
	Sum       :: wire1 xor Cin;
	wire3     :: wire1 and Cin;
	Cout      :: wire2 xor wire3;
	return Sum, Cout;
}


Sum, Cout :: fullAdder(A, B, Cin, Sum, Cout, 8);
// this creates an 8-Bit full adder using a templatized version form


// Analog HDL
//      Analog HDL - VCVS
electrical       :: #import "Hardware/Analog/electrical.a"

VCVS :: (vsense_p : inout, vsense_n : inout, gain : f64) -> (vout_p : inout, vout_n : inout) {
	vout_p = electrical.v(vout_n) + gain * (v(vsense_p) - v(vsense_n));
}

VCVS :: (vsense_p : inout, vsense_n : inout, gain : f64, vout_p : inout, vout_n : inout) {
	vout_p = electrical.v(vout_n) + gain * (v(vsense_p) - v(vsense_n));
}

//      Analog HDL - Two-Sage Amplifier
#import "Hardware/MixedSignal/ams_constants.a"          // Import standard libraries and disciplines
#import "Hardware/MixedSignal/ams_disciplines.a"        // Import standard libraries and disciplines

// Define a module for a two-stage op-amp
TwoStageOpAmp :: module (in_p : Electrical, in_n : Electrical, out : Electrical) {
	// Input and output electrical nodes

	// Parameters with default values
	gain_stage1 :: 1e4;            // Gain of the first stage
	gain_stage2 :: 1e2;            // Gain of the second stage
	gbw         :: 10e6;           // Gain-bandwidth product (Hz)
	cload       :: 10e-12;       // Load capacitance (Farads)
	vcc         :: 1.8;            // Supply voltage (Volts)
	vss         :: 0;              // Ground voltage (Volts)
	v_offset    :: 0;         // Input offset voltage (Volts)
	sr          :: 1e6;             // Slew rate (V/s)
	noise_gain  :: 1;       // Noise gain (dimensionless)

	// Internal state variables
	v_diff      : f64;
	v_out       : f64;
	v_stage1    : f64;
	omega       : f64;

	// Slew rate limiting function
	slew_rate_limit :: (v_in : f64, max_slew_rate: f64) -> f64 {
		if abs(ddt(v_in)) > max_slew_rate {
			return sign(v_in) * max_slew_rate * dt;
		}
		return v_in;
	}

	// Simple noise function
	noise :: (gain: f64) -> f64 {
		return gain * white_noise(1e-6);
	}

	// Simulation block with automatic time stepping
	simulation {
		// Compute differential input voltage
		v_diff = voltage(in_p) - voltage(in_n) + v_offset;

		// First stage gain with automatic slew rate limiting
		v_stage1 = gain_stage1 * v_diff;
		v_stage1 = slew_rate_limit(v_stage1, sr);

		// Second stage gain calculation
		v_out = gain_stage2 * v_stage1;

		// Frequency compensation
		omega = 2 * PI * gbw;
		v_out = v_out / (1 + (omega / (2 * PI * 10)));

		// Output voltage with noise
		voltage(out) = v_out + noise(noise_gain);

		// Output load capacitance effect
		current(out) = cload * ddt(V(out));
	}
}




// Import necessary libraries
#import "Hardware/MixedSignal/ams_constants.a"
#import "Hardware/MixedSignal/ams_disciplines.a"

// Define a higher-level circuit module
CircuitTopLevel :: module (in_p: Electrical, in_n: Electrical, out: Electrical) {
	// Instantiate the TwoStageOpAmp module
	opamp1 :: TwoStageOpAmp (.in_p :: in_p; .in_n :: in_n, .out :: out, .gain_stage1 = 2e4, .gain_stage2 = 1.5e2);

	simulation {
	analog {
		// For example, driving input signals or monitoring outputs
		V(in_p) = sin(2 * PI * 1e3 * time) * 0.01;
		V(in_n) = 0;
	}
}








// Analog Netlist
// ---------------------------------------------------------------------------
analog :: #import "Hardware/analog.a"

// ****************************
// * Two-Stage Op-Amp Circuit *
// ****************************

// Or fore something that looks more like modern syntax .
#import "/path/to/your/model/nmos.a";
#analog.spice.setModelCorner("nmos", "tt");

#import "/path/to/your/model/pmos.a";
#analog.spice.setModelCorner("pmos", "tt");


// Global parameters
Rload := 10k;
Cload := 1p;
Iref  := 100u;

// Power supply
Vdd   :: vsource(vdd, 0, .dc=1.8);

// Bias current source
Ibias :: isource(ibias, 0, .dc=Iref);

// First stage differential pair
Mn1      :: nmos(vout, n1, 0, 0, .w=10u, .l=180n, .m=1);
Mn2      :: nmos(0, n1, n2, 0, .w=10u, .l=180n, .m=1);
Mp1      :: pmos(n2, vdd, 0, 0, .w=20u, .l=180n, .m=1);
Mp2      :: pmos(n1, vdd, 0, 0, .w=20u, .l=180n, .m=1);

// Second stage common-source amplifier
Mn3      :: nmos(vout, 0, n3, 0, .w=30u, .l=180n, .m=1);
Mp3      :: pmos(n3, vdd, 0, 0, .w=60u, .l=180n, .m=1);

// Output load
Rload    :: resistor(vout, 0, .r=Rload);
Cload    :: capacitor(vout, 0, .c=Cload);

// DC Analysis
dcOp     :: analog.analyses.dc {
	.oppoint,
	.saveOppoint=true
};

// AC Analysis
acAc     :: analog.analyses.ac {
	.start=1,
	.stop=1G,
	.dec=10
};

// Transient Analysis
tran     :: analog.analyses.tran {
	.stop=1us,
	.step=1ns
};

// Monte Carlo Analysis
mc1      :: analog.analyses.montecarlo {
	// Vary process parameters
	.process = {
		.dpmos = analog.simulator.functions.gauss(.mean=0, .std=5%, .seed=1),
		.dnm = anlog.simulator.functions.gauss(.mean=0, .std=5%, .seed=2)
	},

	// Mismatch in devices
	.mismatch = {
		.dm1 = analog.simulator.functions.gauss(mean=0 std=0.5% seed=3)
		.dm2 = analog.simulator.functions.gauss(mean=0 std=0.5% seed=4)
	},

	.analysis { .type=analog.analyses.tran },
	.numruns = 100,
	.save=all,
};

// Alter block for different operating points
dev_bias :: analog.analysis.alter {
	// Change bias current
	Ibias.dc = 200u,

	// Re-run DC analysis with new bias
	analog.analyses.dc { .restart=true }
};

// Save data
analog.simulators.spice.options.save("M*", "I*", "V*");

// End of netlist


//Spice
// ---------------------------------------------------------------------------
// Two-Stage Op-Amp Circuit

// Include external model libraries
include "/path/to/your/model/nmos.lib" section=nm
include "/path/to/your/model/pmos.lib" section=pm

// Global parameters
parameters Rload=10k Cload=1p Iref=100u

// Power supply
Vdd (vdd 0) vsource dc=1.8

// Bias current source
Ibias (ibias 0) isource dc=Iref

// First stage differential pair
Mn1 (vout n1 0 0) nmos w=10u l=180n m=1
Mn2 (0 n1 n2 0) nmos w=10u l=180n m=1
Mp1 (n2 vdd 0 0) pmos w=20u l=180n m=1
Mp2 (n1 vdd 0 0) pmos w=20u l=180n m=1

// Second stage common-source amplifier
Mn3 (vout 0 n3 0) nmos w=30u l=180n m=1
Mp3 (n3 vdd 0 0) pmos w=60u l=180n m=1

// Output load
Rload (vout 0) resistor r=Rload
Cload (vout 0) capacitor c=Cload

// DC Analysis
dcOp dc oppoint saveOppoint=yes

// AC Analysis
acAc ac start=1Hz stop=1GHz dec=10

// Transient Analysis
tran tran stop=1us step=1ns

// Monte Carlo Analysis
mc1 montecarlo {
  process { // Vary process parameters
    dpmos = gauss(mean=0 std=5% seed=1)
    dnm = gauss(mean=0 std=5% seed=2)
  }
  mismatch { // Mismatch in devices
    dm1 = gauss(mean=0 std=0.5% seed=3)
    dm2 = gauss(mean=0 std=0.5% seed=4)
  }
  analysis(type=tran)
  numruns = 100
  save=all
}

// Alter block for different operating points
alter dev_bias {
  Ibias dc=200u  // Change bias current
  // Re-run DC analysis with new bias
  dc dc restart=yes
}

// Save data
save M* I* V*

// End of netlist









