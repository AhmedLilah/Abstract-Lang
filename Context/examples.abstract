.    :: #import("basic");
math :: #import("math");

Vec2    :: #(T : _) {
        x, y    :  T;
        r, h, R :: alias x;
        g, s, I :: alias y;
}

Vec3    :: #(T : _) {
        .       :  Vec2(T);
        z       :  T;
        b, l    :: alias z;
}

Vec4    :: #(T : _) {
        .       :  Vec3(T);
        w       :  T;
        a       :: alias w;
}


BW      :: {
        b       :  f32;
}


vec2       :: #(T : _) (n : T) -> (vec : Vec2(T)) {
        vec.x = n;
        vec.y = n;
        return;
}

